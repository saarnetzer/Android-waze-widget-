<?xml version="1.0" encoding="utf-8"?>
<!-- The run log can contain text from Waze's screen (e.g. recent destinations): keep it on the device only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
